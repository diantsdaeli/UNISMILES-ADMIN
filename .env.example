PORT=3000

# Backend API Base URL (default backend runs on port 8000 or 5017)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend Public Base URL for static assets (/uploads)
VITE_PUBLIC_BASE_URL=http://localhost:8000

# To enable real AI Generation features, insert your Gemini API key below:
GEMINI_API_KEY=

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=unismiles
